FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for file processing
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    libreoffice \
    tzdata \
    unzip \
    poppler-utils \
    nodejs \
    npm && \
    curl -fsSL https://dl.deno.land/release/v2.7.5/deno-x86_64-unknown-linux-gnu.zip -o /tmp/deno.zip && \
    unzip /tmp/deno.zip -d /usr/local/bin && \
    chmod +x /usr/local/bin/deno && \
    rm /tmp/deno.zip && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash appuser && \
    chown -R appuser:appuser /app

# Copy dependency files
COPY pyproject.toml ./
COPY api/requirements.txt ./requirements.txt
COPY api/constraints.txt ./constraints.txt

# Install Python dependencies
# Note: Using pip instead of uv because uv lacks --trusted-host equivalent for
# handling corporate proxies/firewalls with self-signed certificates
RUN pip install --no-cache-dir \
    --timeout=600 \
    --trusted-host pypi.org \
    --trusted-host pypi.python.org \
    --trusted-host files.pythonhosted.org \
    -c constraints.txt \
    -e . && \
    pip install --no-cache-dir \
    --timeout=600 \
    --trusted-host pypi.org \
    --trusted-host pypi.python.org \
    --trusted-host files.pythonhosted.org \
    -r requirements.txt

# Install Playwright browser binaries and Linux runtime dependencies in a
# shared path for non-root runtime user.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium && \
    chown -R appuser:appuser /ms-playwright

# Copy API code
COPY --chown=appuser:appuser api/ ./api/
COPY --chown=appuser:appuser workers/ ./workers/
COPY --chown=appuser:appuser skills/ ./skills/
COPY --chown=appuser:appuser scripts/ ./scripts/

# Create writable directories for non-root user
RUN mkdir -p /workspace /tmp && \
    chown -R appuser:appuser /workspace /tmp /app/api /app/workers /app/skills /app/scripts

# Copy entrypoint
COPY docker/entrypoint.sh /app/entrypoint.sh
COPY docker/playwright_smoke_check.py /app/playwright_smoke_check.py
RUN chmod +x /app/entrypoint.sh

# Switch to root for entrypoint to manage volumes, then drop privileges
USER root

# Configure yt-dlp JS runtime for YouTube downloads
ENV YT_DLP_JS_RUNTIMES=node
ENV PLAYWRIGHT_STARTUP_CHECK=1
ENV REQUESTS_CA_BUNDLE=/usr/lib/ssl/cert.pem
ENV SSL_CERT_FILE=/usr/lib/ssl/cert.pem

# Expose API port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/api/health').read()"

# Start FastAPI server
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8001"]
